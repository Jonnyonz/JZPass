# Configuración del Sistema
APP_PORT=8000
# Interfaz donde Docker publica la app. Detrás de un proxy inverso, poner 127.0.0.1
APP_BIND=0.0.0.0
TZ=America/Argentina/Buenos_Aires
ALLOWED_ORIGINS=http://localhost:8000,https://midominio.com

# Proxies inversos de confianza (IPs o redes, separadas por coma). Solo desde ellos se cree
# el encabezado X-Forwarded-For para calcular la IP real (rate limit). Por defecto: loopback
# y redes de Docker (proxy en el mismo servidor).
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# Seguridad y Firmas. Generar con: openssl rand -hex 32
JWT_SECRET=ingresa_una_cadena_muy_larga_y_segura_aqui

# Token de configuración inicial (se pide una sola vez, en la primera pantalla,
# para crear el usuario administrador). install.sh lo genera solo y lo muestra al terminar.
SETUP_TOKEN=se_genera_automaticamente_al_instalar

# Base de Datos PostgreSQL
DB_USER=jzadmin
DB_PASSWORD=ingresa_tu_password_segura
DB_NAME=jzpass_db

# Con Docker Compose, DATABASE_URL se arma solo a partir de DB_USER/DB_PASSWORD/DB_NAME
# (ver docker-compose.yml) y esta variable no hace falta.
# Sin Docker (instalación nativa), la app la exige sí o sí: exportarla a mano apuntando
# a Postgres local. Formato: postgresql://usuario:password@host:puerto/nombre_db
# Ejemplo: postgresql://jzadmin:ingresa_tu_password_segura@localhost:5432/jzpass_db
DATABASE_URL=postgresql://jzadmin:ingresa_tu_password_segura@localhost:5432/jzpass_db
